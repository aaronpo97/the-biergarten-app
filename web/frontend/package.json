{
    "name": "biergarten-website",
    "type": "module",
    "version": "0.0.0",
    "scripts": {
        "dev": "react-router dev",
        "build": "react-router build",
        "start": "NODE_ENV=production node ./build/server/index.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typegen": "react-router typegen",
        "typecheck": "npm run typegen && tsc -p tsconfig.json",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test:storybook": "vitest run --project storybook",
        "test:storybook:playwright": "playwright test -c playwright.storybook.config.ts"
    },
    "dependencies": {
        "@headlessui/react": "^2.2.10",
        "@hookform/resolvers": "^5.9.1",
        "@react-router/dev": "^8.3.0",
        "@react-router/express": "^8.3.0",
        "@react-router/node": "^8.3.0",
        "iconoir-react": "^7.11.1",
        "isbot": "^5.2.1",
        "leaflet": "^1.9.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.86.0",
        "react-hot-toast": "^2.6.0",
        "react-leaflet": "^5.0.0-rc.2",
        "react-router": "^8.3.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.0.1",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.59.1",
        "@storybook/addon-a11y": "^10.5.10",
        "@storybook/addon-docs": "^10.2.19",
        "@storybook/addon-onboarding": "^10.5.10",
        "@storybook/addon-vitest": "^10.2.19",
        "@storybook/react-vite": "^10.2.19",
        "@tailwindcss/postcss": "^4.2.1",
        "@types/express": "^5.0.6",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^25.5.2",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/browser-playwright": "^4.1.11",
        "@vitest/coverage-v8": "^4.1.11",
        "autoprefixer": "^10.4.2",
        "daisyui": "^5.5.19",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-storybook": "^10.2.19",
        "globals": "^17.11.0",
        "playwright": "^1.62.1",
        "postcss": "^8.5.26",
        "prettier": "^3.9.6",
        "storybook": "^10.5.10",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^7.0.8",
        "vitest": "^4.1.11"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
