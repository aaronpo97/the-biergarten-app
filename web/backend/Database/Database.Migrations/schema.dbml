Table UserAccount {
  UserAccountID uniqueidentifier [pk, default: `newid()`]
  Username varchar(64) [not null, unique]
  FirstName nvarchar(128) [not null]
  LastName nvarchar(128) [not null]
  Email varchar(128) [not null, unique]
  CreatedAt datetime [not null, default: `getdate()`]
  UpdatedAt datetime
  DateOfBirth date [not null]
  RowVersion rowversion
}

Table Photo {
  PhotoID uniqueidentifier [pk, default: `newid()`]
  Hyperlink nvarchar(256) [note: 'storage handled via filesystem/cloud service']
  UploadedByID uniqueidentifier [not null]
  UploadedAt datetime [not null, default: `getdate()`]
  RowVersion rowversion

  Note: 'A user account cannot be deleted while it has uploaded photos'

  Indexes {
    UploadedByID
  }
}

Table UserAvatar {
  UserAvatarID uniqueidentifier [pk, default: `newid()`]
