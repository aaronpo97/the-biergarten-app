  }
}

Table UserFollow {
  UserFollowID uniqueidentifier [pk, default: `newid()`]
  UserAccountID uniqueidentifier [not null]
  FollowingID uniqueidentifier [not null]
  CreatedAt datetime [not null, default: `getdate()`]
  RowVersion rowversion

  Note: 'CHECK: UserAccountID != FollowingID (cannot follow own account)'

  Indexes {
    (UserAccountID, FollowingID)
