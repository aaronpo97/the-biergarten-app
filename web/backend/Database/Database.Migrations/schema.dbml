  RowVersion rowversion

  Note: 'Deleted when the user account is deleted'
}

Table UserVerification {
  UserVerificationID uniqueidentifier [pk, default: `newid()`]
  UserAccountID uniqueidentifier [not null, unique]
  VerificationDateTime datetime [not null, default: `getdate()`]
  RowVersion rowversion

  Note: 'Deleted when the user account is deleted'
}

Table UserCredential {
  UserCredentialID uniqueidentifier [pk, default: `newid()`]
  UserAccountID uniqueidentifier [not null]
  CreatedAt datetime [not null, default: `getdate()`]
  Expiry datetime [not null, default: `dateadd(day, 90, getdate())`]
  Hash nvarchar(256) [not null, note: 'argon2 hash']
  IsRevoked bit [not null, default: 0]
  RevokedAt datetime
  RowVersion rowversion

  Note: 'Deleted when the user account is deleted'

  Indexes {
